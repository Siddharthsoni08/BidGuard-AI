{
  "dataset_name": "BidGuard AI \u2013 Synthetic Integrated Bid Compliance Verification Dataset",
  "version": "1.0.0",
  "problem_statement_id": "SIH26100",
  "seed": 26100,
  "synthetic_only": true,
  "identifiers_note": "All company names, organizations, certificate identifiers, GST-like/PAN-like/Udyam-like values and document content are synthetic and must not be interpreted as real records.",
  "risk_target": "risk_level",
  "ml_input_features": [
    "total_requirements",
    "mandatory_requirements",
    "compliant_count",
    "partially_compliant_count",
    "non_compliant_count",
    "insufficient_evidence_count",
    "compliance_percentage",
    "missing_document_count",
    "expired_document_count",
    "invalid_document_count",
    "inconsistency_count",
    "evidence_confidence_average",
    "mandatory_failure_count",
    "financial_requirement_failure",
    "experience_requirement_failure",
    "registration_requirement_failure",
    "authorization_requirement_failure",
    "document_quality_score"
  ],
  "risk_score_internal_only": true,
  "split_method": "Tender-level group split",
  "split_counts": {
    "train": 840,
    "validation": 180,
    "test": 180
  },
  "validation_checks": {
    "exactly_1200_tenders": true,
    "unique_tenders": true,
    "unique_tender_requirements": true,
    "unique_bidders": true,
    "unique_bidder_tenders": true,
    "unique_documents": true,
    "unique_document_fields": true,
    "unique_document_pages": true,
    "unique_evidence": true,
    "unique_requirement_evidence": true,
    "unique_compliance_results": true,
    "unique_recommendations": true,
    "unique_audit_trail": true,
    "requirements_per_tender": true,
    "bidders_per_tender": true,
    "fk_tender_requirements_tender_id": true,
    "fk_bidder_tenders_tender_id": true,
    "fk_bidder_tenders_bidder_id": true,
    "fk_documents_tender_id": true,
    "fk_documents_bidder_id": true,
    "fk_document_fields_document_id": true,
    "fk_document_pages_document_id": true,
    "fk_evidence_document_id": true,
    "fk_evidence_tender_id": true,
    "fk_evidence_bidder_id": true,
    "fk_requirement_evidence_requirement_id": true,
    "fk_requirement_evidence_document_id": true,
    "fk_requirement_evidence_evidence_id": true,
    "fk_compliance_results_requirement_id": true,
    "fk_compliance_results_evidence_id": true,
    "page_count_exact": true,
    "document_issue_before_deadline": true,
    "expiry_after_issue": true,
    "no_risk_score_feature": true,
    "no_risk_level_feature": true,
    "ml_features_exist": true,
    "risk_distribution_range": true,
    "split_counts": true,
    "split_no_overlap": true,
    "split_coverage": true,
    "valid_compliance_labels": true,
    "valid_evidence_labels": true,
    "missing_evidence_label_consistency": true,
    "risk_classes": true
  }
}